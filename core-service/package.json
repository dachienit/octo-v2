{
	"name": "@octo/service",
	"version": "0.0.1",
	"description": "Octo core service",
	"type": "module",
	"bin": {
		"octo": "dist/main.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"dev:http": "npm run build && node dist/main.js --http ../workspace",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "^3.1050.0",
		"@octo/core": "*",
		"@slack/socket-mode": "^2.0.0",
		"@slack/web-api": "^7.0.0",
		"chalk": "^5.6.2",
		"croner": "^9.1.0",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^24.3.0",
		"@types/passport": "^1.0.17",
		"@types/passport-local": "^1.0.38",
		"@typescript/native-preview": "^7.0.0-dev.20260120.1",
		"typescript": "^5.7.3"
	},
	"keywords": [
		"bot",
		"ai",
		"agent"
	],
	"license": "UNLICENSED",
	"engines": {
		"node": ">=20.0.0"
	}
}
