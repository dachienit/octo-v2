# LLM configuration
# Provider name - must match a known provider in @earendil-works/pi-ai
# Examples: openai, anthropic, openrouter, groq, openai-codex
LLM_PROVIDER=openai

# Model ID for the chosen provider
LLM_MODEL=gpt-4o-mini

# ChatGPT Codex OAuth provider:
#   1. Start core-service with:
#      LLM_PROVIDER=openai-codex
#      LLM_MODEL=gpt-5.4
#   2. Sign in to the web app, then run Codex login from that user session.
#      Each core-service user gets a separate auth file under:
#      {core-service data root}/users/{user-id}/auth.json

# Disable new account signup after the first local user exists.
# CORE_SERVICE_ALLOW_SIGNUP=false

# Required to store per-user LLM provider API keys (OpenAI / Anthropic / Google).
# Keys are encrypted at rest with AES-256-GCM using this value. Provide a 32-byte
# key as 64 hex chars or 44 base64 chars, or any passphrase (stretched via scrypt).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CORE_SERVICE_ENCRYPTION_KEY=

# Custom API base URL - use this for OpenAI-compatible endpoints:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
#   OpenRouter: https://openrouter.ai/api/v1
# LLM_BASE_URL=http://localhost:11434/v1

# API key - alternative to storing in ~/.pi/mom/auth.json
# LLM_API_KEY=sk-...

# Core service port (default: 3030)
# PORT=3030

# Bosch GitHub Enterprise Server (GHES) SSO — OAuth 2.0 login (IYH1HC add)
# Register an OAuth App on the GHES instance (Settings > Developer settings >
# OAuth Apps) and set the callback to SSO_GITHUB_REDIRECT_URI below.
# SSO_GITHUB_ENABLED=true
# SSO_GITHUB_BASE_URL=https://github.boschdevcloud.com
# SSO_GITHUB_CLIENT_ID=<oauth-app-client-id>
# SSO_GITHUB_CLIENT_SECRET=<oauth-app-client-secret>
# SSO_GITHUB_REDIRECT_URI=http://localhost:3030/auth/sso/callback
# SSO_GITHUB_SCOPES=read:user user:email
# SSO_GITHUB_LABEL=Bosch GitHub
# SSO_POST_LOGIN_REDIRECT=http://localhost:5173
# If a corporate proxy is set, make sure github.boschdevcloud.com is in NO_PROXY.

# SAP AI Core custom provider extension
# AICORE_SERVICE_KEY={"serviceurls":{"AI_API_URL":"https://..."},"clientid":"...","clientsecret":"...","url":"https://..."}
# SAP_AI_RESOURCE_GROUP=default
# SAP_AI_CORE_API_KEY=...
# SAP_AI_OPENAI_MODEL=gpt-4.1
# SAP_AI_CLAUDE_MODEL=claude-sonnet-4-5
